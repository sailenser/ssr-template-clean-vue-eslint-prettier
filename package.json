{
  "name": "uch-vue-ssr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist-ssr/client",
    "build:server": "vite build --outDir dist-ssr/server --ssr src/entry-server.ts",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.vue,.ts --fix src",
    "lint:fix": "eslint --ext .js,.vue,.ts src/ --fix",
    "format": "prettier .  --write"
  },
  "dependencies": {
    "express": "^5.3.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.4",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.6",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
